    <string name="perm_why_needed">Why Ronova requires these permissions:</string>
    <string name="perm_bt_title">Nearby Devices &amp; Bluetooth</string>
    <string name="perm_bt_desc">Enables discovering, connecting, and exchanging encrypted packets with nearby compatible mesh nodes.</string>
    <string name="perm_loc_title">Location (Android 11 Scanning Only)</string>
    <string name="perm_loc_desc">Required exclusively by Android 11 OS for Bluetooth discovery. Never used to track physical location.</string>
    <string name="perm_mic_title">Microphone Access (Voice Calls Only)</string>
    <string name="perm_mic_desc">Used exclusively for transmitting audio during active offline voice calls. Never recorded silently.</string>
    <string name="perm_notif_title">Notifications &amp; Background Service</string>
    <string name="perm_notif_desc">Maintains the foreground mesh service so intermediate nodes can forward messages with the screen off.</string>
    <string name="perm_zero_location_title">Zero Location Tracking</string>
    <string name="perm_zero_location_desc">We configure Bluetooth with \'neverForLocation\'. Your physical GPS coordinates are never accessed or shared.</string>
