    <string name="perm_mic_required_message">Microphone access is needed for offline voice calls. Bluetooth messaging continues to work without it.</string>
    <string name="perm_mic_explanation">Voice calls transmit real-time microphone audio over Bluetooth. If permission is denied, voice calls cannot start, but all text messaging and relay features remain fully operational.</string>
