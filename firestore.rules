rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.uid is string && data.uid.size() > 0 && data.uid.size() <= 128 &&
             data.ronovaId is string && data.ronovaId.size() > 0 && data.ronovaId.size() <= 32 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 60 &&
             (!('photoUrl' in data) || data.photoUrl == null || (data.photoUrl is string && data.photoUrl.size() <= 1000)) &&
             (!('bio' in data) || data.bio == null || (data.bio is string && data.bio.size() <= 300)) &&
             (!('profileVisibility' in data) || (data.profileVisibility in ['public', 'friends_only', 'private'])) &&
             (!('presencePrivacy' in data) || (data.presencePrivacy in ['public', 'friends_only', 'nobody'])) &&
             (!('isOnline' in data) || data.isOnline is bool) &&
             (!('presenceUpdatedAt' in data) || data.presenceUpdatedAt == null || data.presenceUpdatedAt is timestamp) &&
             (!('accountStatus' in data) || (data.accountStatus in ['active', 'suspended'])) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp);
    }

    function isValidFriendRequest(data) {
      return data.senderUid is string && data.senderUid.size() > 0 && data.senderUid.size() <= 128 &&
             data.recipientUid is string && data.recipientUid.size() > 0 && data.recipientUid.size() <= 128 &&
             data.status in ['pending', 'accepted', 'rejected', 'cancelled'] &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('senderRonovaId' in data) || (data.senderRonovaId is string && data.senderRonovaId.size() <= 32)) &&
             (!('senderDisplayName' in data) || (data.senderDisplayName is string && data.senderDisplayName.size() <= 60)) &&
             (!('senderPhotoUrl' in data) || (data.senderPhotoUrl is string && data.senderPhotoUrl.size() <= 1000)) &&
             (!('recipientRonovaId' in data) || (data.recipientRonovaId is string && data.recipientRonovaId.size() <= 32)) &&
             (!('recipientDisplayName' in data) || (data.recipientDisplayName is string && data.recipientDisplayName.size() <= 60)) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp) &&
             (!('updatedAt' in data) || data.updatedAt == null || data.updatedAt is timestamp);
    }

    function isValidFriendship(data) {
      return data.userAUid is string && data.userAUid.size() > 0 && data.userAUid.size() <= 128 &&
             data.userBUid is string && data.userBUid.size() > 0 && data.userBUid.size() <= 128 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('userARonovaId' in data) || (data.userARonovaId is string && data.userARonovaId.size() <= 32)) &&
             (!('userBRonovaId' in data) || (data.userBRonovaId is string && data.userBRonovaId.size() <= 32)) &&
             (!('userADisplayName' in data) || (data.userADisplayName is string && data.userADisplayName.size() <= 60)) &&
             (!('userBDisplayName' in data) || (data.userBDisplayName is string && data.userBDisplayName.size() <= 60)) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp);
    }

    function isValidConversation(data) {
      return data.participants is list && data.participants.size() >= 1 && data.participants.size() <= 10 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('lastMessageText' in data) || (data.lastMessageText is string && data.lastMessageText.size() <= 4000)) &&
             (!('lastSenderUid' in data) || (data.lastSenderUid is string && data.lastSenderUid.size() <= 128)) &&
             (!('lastMessageTimestamp' in data) || data.lastMessageTimestamp == null || data.lastMessageTimestamp is timestamp);
    }

    function isValidDirectMessage(data) {
      return data.senderUid is string && data.senderUid.size() > 0 && data.senderUid.size() <= 128 &&
             data.recipientUid is string && data.recipientUid.size() > 0 && data.recipientUid.size() <= 128 &&
             data.text is string && data.text.size() > 0 && data.text.size() <= 4000 &&
             (!('id' in data) || (data.id is string && data.id.size() <= 128)) &&
             (!('conversationId' in data) || (data.conversationId is string && data.conversationId.size() <= 128)) &&
             (!('deliveryState' in data) || (data.deliveryState in ['sent', 'delivered', 'read'])) &&
             (!('transportType' in data) || (data.transportType in ['internet', 'bluetooth_direct', 'bluetooth_mesh'])) &&
             (!('createdAt' in data) || data.createdAt == null || data.createdAt is timestamp);
    }

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Users directory and profiles
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == request.auth.uid;
      allow update: if isOwner(userId) &&
                       isValidUserProfile(incoming()) &&
                       incoming().uid == existing().uid &&
                       incoming().ronovaId == existing().ronovaId &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'displayName', 'photoUrl', 'bio', 'profileVisibility',
                         'presencePrivacy', 'isOnline', 'presenceUpdatedAt'
                       ]);
      allow delete: if isOwner(userId);
    }

    // Friend requests
    match /friend_requests/{requestId} {
      allow read: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
                       isValidFriendRequest(incoming()) &&
                       incoming().senderUid == request.auth.uid &&
                       incoming().senderUid != incoming().recipientUid &&
                       incoming().status == 'pending';
      allow update: if isSignedIn() &&
                       isValidFriendRequest(incoming()) &&
                       incoming().senderUid == existing().senderUid &&
                       incoming().recipientUid == existing().recipientUid &&
                       (!('createdAt' in existing()) || incoming().createdAt == existing().createdAt) &&
                       (
                         // Recipient can accept or reject
                         (existing().recipientUid == request.auth.uid &&
                          incoming().status in ['accepted', 'rejected'] &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                         ||
                         // Sender can cancel
                         (existing().senderUid == request.auth.uid &&
                          incoming().status == 'cancelled' &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']))
                       );
      allow delete: if isSignedIn() && (
        resource.data.senderUid == request.auth.uid ||
        resource.data.recipientUid == request.auth.uid
      );
    }

    // Friendships
    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && (
        resource.data.userAUid == request.auth.uid ||
        resource.data.userBUid == request.auth.uid
      );
      allow create: if isSignedIn() &&
                       isValidFriendship(incoming()) &&
                       (incoming().userAUid == request.auth.uid || incoming().userBUid == request.auth.uid) &&
                       incoming().userAUid != incoming().userBUid;
      allow update: if isSignedIn() &&
                       isValidFriendship(incoming()) &&
                       (existing().userAUid == request.auth.uid || existing().userBUid == request.auth.uid) &&
                       incoming().userAUid == existing().userAUid &&
                       incoming().userBUid == existing().userBUid;
      allow delete: if isSignedIn() && (
        resource.data.userAUid == request.auth.uid ||
        resource.data.userBUid == request.auth.uid
      );
    }

    // Conversations
    match /conversations/{conversationId} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants
      );
      allow create: if isSignedIn() &&
                       isValidConversation(incoming()) &&
                       request.auth.uid in incoming().participants;
      allow update: if isSignedIn() &&
                       isValidConversation(incoming()) &&
                       request.auth.uid in existing().participants &&
                       incoming().participants == existing().participants;
      allow delete: if isSignedIn() && (
        request.auth.uid in resource.data.participants
      );

      // Subcollection: messages
      match /messages/{messageId} {
        allow read: if isSignedIn() && (
          resource.data.senderUid == request.auth.uid ||
          resource.data.recipientUid == request.auth.uid
        );
        allow create: if isSignedIn() &&
                         isValidDirectMessage(incoming()) &&
                         incoming().senderUid == request.auth.uid;
        allow update: if isSignedIn() &&
                         isValidDirectMessage(incoming()) &&
                         incoming().senderUid == existing().senderUid &&
                         incoming().recipientUid == existing().recipientUid &&
                         incoming().text == existing().text &&
                         (
                           // Recipient updates deliveryState (e.g. delivered, read)
                           (existing().recipientUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['deliveryState']))
                           ||
                           // Sender updates deliveryState
                           (existing().senderUid == request.auth.uid &&
                            incoming().diff(existing()).affectedKeys().hasOnly(['deliveryState', 'transportType']))
                         );
        allow delete: if isSignedIn() && (
          resource.data.senderUid == request.auth.uid
        );
      }
    }
  }
}
